{
  "name": "floating-personal-gantt",
  "version": "0.1.0",
  "description": "Aplicación de escritorio ultra-ligera y moderna para Windows con diagrama de Gantt flotante, modo Click-Through, mini-widget HUD y persistencia desacoplada.",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "start": "electron .",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "lint": "eslint src --ext .ts,.html",
    "test": "vitest run",
    "package:win": "npm run build && npm run build:electron && electron-builder --win"
  },
  "keywords": [
    "gantt",
    "floating",
    "productivity",
    "windows",
    "glassmorphism",
    "time-blocking",
    "widget"
  ],
  "author": "Floating Personal Gantt Contributors",
  "license": "MIT",
  "devDependencies": {
    "electron": "^34.2.0",
    "electron-builder": "^25.1.8",
    "happy-dom": "^20.11.2",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitest": "^3.0.5"
  },
  "build": {
    "appId": "com.jtorres.floatingpersonalgantt",
    "productName": "Floating Personal Gantt",
    "win": {
      "target": [
        "portable",
        "nsis"
      ]
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "directories": {
      "output": "release"
    }
  }
}
